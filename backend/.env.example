# ===================================================================
# Vaeto Technology CRM Backend - Environment Configuration Template
# Copy this file to '.env' or export these environment variables before
# running the Spring Boot backend.
# DO NOT COMMIT REAL PASSWORDS TO GIT.
# ===================================================================

# Database Connection (MySQL / TiDB)
DB_URL=jdbc:mysql://localhost:3306/vaeto_lead_management?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
SERVER_PORT=8080

# JWT Authentication Secret (Must be at least 256 bits / 32 characters base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# CORS Origin (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173
